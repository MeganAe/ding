# Chaîne de connexion PostgreSQL (Neon, Railway, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Mettre "false" uniquement pour une base locale sans SSL
DATABASE_SSL=true
# Longue chaîne aléatoire, jamais partagée
JWT_SECRET=change-moi-avec-une-longue-valeur-aleatoire
# Mode campus : domaine d'email obligatoire (vide = tout le monde)
ALLOWED_EMAIL_DOMAIN=
# Rayon de l'alarme en mètres
ALARM_RADIUS_METERS=150
# Fréquence d'interrogation des alarmes et d'envoi de la position, en secondes.
# L'app les lit via GET /config : une valeur changée ici s'applique sans
# publier une nouvelle version sur le Play Store.
ALARM_POLL_SECONDS=20
LOCATION_INTERVAL_SECONDS=120
# Modération : emails des comptes qui voient la file de signalements.
# Séparés par des virgules. Un compte dont l'email figure ici devient
# modérateur à sa prochaine connexion (aucune migration de données).
ADMIN_EMAILS=
# Version des conditions d'utilisation acceptée à l'inscription. À changer
# quand le texte change : GET /config la publie, l'app compare avec la version
# du compte et redemande l'acceptation si elles diffèrent.
TERMS_VERSION=2026-11-01
# Envoi d'emails (Resend). Sert aux codes de réinitialisation, aux codes de
# vérification d'adresse et aux avis de signalement à l'équipe.
# Vide = les emails vont dans les logs du serveur.
RESEND_API_KEY=
# Expéditeur (domaine vérifié chez Resend)
MAIL_FROM=Ding <onboarding@resend.dev>
# Quotas (facultatif : les valeurs par défaut suffisent en production).
# Les tests de parcours les augmentent pour créer beaucoup de comptes vite.
# AUTH_RATE_LIMIT=30
# API_RATE_LIMIT=240
# LOCATION_RATE_LIMIT=20
